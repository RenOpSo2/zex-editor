modules = ["python-3.12"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Zex Editor"

[[workflows.workflow]]
name = "Run Zex Editor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "make && ./bin/zex"

[workflows.workflow.metadata]
outputType = "console"
